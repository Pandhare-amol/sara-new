{
  "name": "sara",
  "productName": "Sara",
  "description": "Sara — a private 3D AI desktop companion powered by each user's own Gemini API key.",
  "author": "Sara",
  "private": true,
  "version": "1.5.2",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:cognition": "node --import tsx --test cognition/tests/*.test.ts",
    "test:screen-vision": "node --import tsx --test server_screenVision.test.ts",
    "test:real-browser": "node --import tsx --test server_realBrowser.test.ts",
    "test:api-hub": "node --import tsx --test api_hub/tests/*.test.ts",
    "test:python": "python -m unittest discover -s desktop_agent -p \"test_*.py\"",
    "simulate:cognition": "tsx scripts/simulate-cognition.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "electron": "electron .",
    "app": "npm run build:windows-bridge && npm run build:desktop-host && npm run build:live-core-host && npm run build && electron .",
    "dist": "npm run build:windows-bridge && npm run build:desktop-host && npm run build:live-core-host && npm run build && npm run build:launcher && electron-builder --win nsis portable",
    "dist:public": "set VITE_SARA_PUBLIC=1&& npm run build:windows-bridge && npm run build:desktop-host && npm run build:live-core-host && npm run build && npm run build:launcher && electron-builder --config electron-builder.public.yml --win nsis portable",
    "kill:native-locks": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clear-native-build-locks.ps1",
    "build:windows-bridge": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clear-native-build-locks.ps1 -Target WindowsBridge && dotnet publish sara-windows/native/WindowsBridge/WindowsBridge.csproj --configuration Release --runtime win-x64 --self-contained true -p:PublishSingleFile=true --output sara-windows/native/WindowsBridge/publish",
    "test:windows-bridge": "npm run kill:native-locks && dotnet run --project sara-windows/native/WindowsBridge.Tests/WindowsBridge.Tests.csproj --configuration Release && npm run build:windows-bridge && node --import tsx --test tests/windowsBridge.integration.test.ts",
    "build:desktop-host": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clear-native-build-locks.ps1 -Target DesktopHost && dotnet publish sara-windows/native/DesktopHost/Sara.DesktopHost.csproj --configuration Release --runtime win-x64 --self-contained true -p:PublishSingleFile=true --output sara-windows/native/DesktopHost/publish",
    "build:live-core-host": "dotnet publish \"assets/core ui/desktop-host/dotnet/SaraLiveCoreHost/SaraLiveCoreHost.csproj\" --configuration Release --runtime win-x64 --self-contained true -p:PublishSingleFile=true --output \"assets/core ui/desktop-host/dotnet/SaraLiveCoreHost/publish\"",
    "test:desktop-host": "npm run build:desktop-host && node -e \"const {spawnSync}=require('node:child_process');const path=require('node:path');const r=spawnSync(path.resolve('sara-windows/native/DesktopHost/publish/Sara.DesktopHost.exe'),['--self-test'],{encoding:'utf8'});if(r.error)throw r.error;if(r.stdout)process.stdout.write(r.stdout);if(r.stderr)process.stderr.write(r.stderr);const d=JSON.parse(r.stdout);if(r.status!==0||!d.ok||d.dpiMode!=='PerMonitorV2'||Number(d.windowsBuild)<22000||d.monitorCount<1||d.explorerRunning!==true||d.wallpaperHost!==false)process.exit(1)\"",
    "test:desktop-host:webview": "node --import tsx --test tests/desktopHost.webview.integration.test.ts",
    "build:launcher": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-launcher.ps1",
    "shell:diagnose": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sara-shell-recovery.ps1 -Action diagnose",
    "shell:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sara-shell-recovery.ps1 -Action backup",
    "shell:rollback": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sara-shell-recovery.ps1 -Action rollback",
    "deployment:inspect": "powershell -NoProfile -ExecutionPolicy Bypass -File sara-windows/deployment/SaraDeployment.ps1 -Action inspect",
    "test:windows-phase2:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-phase2-e2e.ps1 -Scenario all",
    "test:windows-version": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-phase2-e2e.ps1 -Scenario windows-version",
    "test:monitor-topology": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-phase2-e2e.ps1 -Scenario monitor-topology",
    "test:explorer-fallback": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-phase2-e2e.ps1 -Scenario explorer-fallback",
    "test:runtime-stability": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-sara-runtime.ps1",
    "build:desktop-host:experimental": "dotnet build sara-windows/native/SaraDesktopHost/Sara.DesktopHost.Experimental.csproj",
    "inspect:desktop-hierarchy": "dotnet run --project sara-windows/native/SaraDesktopHost/Sara.DesktopHost.Experimental.csproj -- --inspect",
    "run:desktop-surface": "powershell -NoProfile -Command \"$env:SARA_EXPERIMENTAL_SURFACE='1'; dotnet run --project sara-windows/native/SaraDesktopHost/Sara.DesktopHost.Experimental.csproj -- --surface\"",
    "run:desktop-background": "dotnet run --project sara-windows/native/DesktopHost/Sara.DesktopHost.csproj -- --origin=http://127.0.0.1:3000 --background",
    "observe:explorer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/observe-explorer-hierarchy.ps1",
    "deployment:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File sara-windows/deployment/SaraDeployment.ps1 -Action backup",
    "deployment:validate": "powershell -NoProfile -ExecutionPolicy Bypass -File sara-windows/deployment/SaraDeployment.ps1 -Action validate",
    "deployment:status": "powershell -NoProfile -ExecutionPolicy Bypass -File sara-windows/deployment/SaraDeployment.ps1 -Action status",
    "deployment:rollback": "powershell -NoProfile -ExecutionPolicy Bypass -File sara-windows/deployment/SaraDeployment.ps1 -Action rollback",
    "test:characters": "node --import tsx --test tests/characters.test.ts",
    "test:app-settings": "node --import tsx --test tests/appSettings.test.ts",
    "test:companion-layer": "node --import tsx --test tests/companionLayerPolicy.test.ts",
    "test:agent": "node --import tsx --test tests/core.test.ts tests/models.test.ts tests/agentLoop.test.ts tests/presence.test.ts tests/chatOpen.test.ts",
    "test": "npm run lint && npm run test:agent && npm run test:characters && npm run test:app-settings && npm run test:companion-layer && npm run test:cognition && npm run test:screen-vision && npm run test:api-hub && npm run test:python",
    "import:character": "tsx tools/import-character.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "koffi": "^2.16.3",
    "lucide-react": "^0.546.0",
    "mmd-parser": "^1.0.4",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.180.0",
    "vite": "^6.2.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/three": "^0.185.1",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
